MONGODB_URI=mongodb://localhost:27017/blogging_app
MONGODB_DATABASE=blogging_platform

ENVIRONMENT=dev

API_VERSION=1.0.0

SERVER_URI=http://localhost:8080

API_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=86400000

# OAuth2 Google Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_SUCCESS_REDIRECT_URL=

# Async Configuration
ASYNC_CORE_POOL_SIZE=4
ASYNC_MAX_POOL_SIZE=20
ASYNC_QUEUE_CAPACITY=500

# Analytics Cleanup Configuration
ANALYTICS_CLEANUP_RATE_MS=3600000