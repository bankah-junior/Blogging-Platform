MONGODB_URI=mongodb://localhost:27017/blogging_app
MONGODB_DATABASE=blogging_platform

ENVIRONMENT=dev

API_VERSION=1.0.0

SERVER_URI=http://localhost:8080

API_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-make-it-very-long-and-secure
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=86400000

# OAuth2 Google Configuration
GOOGLE_CLIENT_ID=your-actual-client-id-from-google-console
GOOGLE_CLIENT_SECRET=your-actual-client-secret-from-google-console
OAUTH2_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
OAUTH2_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/callback