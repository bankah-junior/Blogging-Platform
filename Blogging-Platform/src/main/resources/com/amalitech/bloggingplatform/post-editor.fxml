<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #ffffff;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.amalitech.bloggingplatform.controller.PostEditorController">
   <children>
      <Label text="Create/Edit Post" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
      
      <Label text="Title:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
      <TextField fx:id="titleField" promptText="Enter post title..." style="-fx-padding: 8;" />
      
      <Label text="Content:" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
      <TextArea fx:id="contentArea" promptText="Enter post content..." prefRowCount="10" wrapText="true" style="-fx-padding: 8;" />
      
      <HBox spacing="10">
         <CheckBox fx:id="publishedCheckBox" text="Published" selected="true" />
         <Region HBox.hgrow="ALWAYS" />
      </HBox>
      
      <Label text="Tags (comma-separated):" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
      <TextField fx:id="tagsField" promptText="e.g., java, mongodb, tutorial" style="-fx-padding: 8;" />
      
      <HBox spacing="10" alignment="CENTER_RIGHT">
         <Button fx:id="cancelButton" text="Cancel" onAction="#onCancelClick" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 20;" />
         <Button fx:id="saveButton" text="Save Post" onAction="#onSaveClick" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-padding: 10 20;" />
      </HBox>
   </children>
</VBox>
