<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.amalitech.bloggingplatform.controller.ProfileSettingsController"
      spacing="20" style="-fx-padding: 25; -fx-background-color: #f8fafc;">

    <Label text="Profile Settings" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

    <Separator/>

    <!-- User Details Section -->
    <GridPane hgap="10" vgap="12">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        </rowConstraints>

        <Label text="Username:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" promptText="Enter new username" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Email:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" promptText="Enter new email" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator/>

    <!-- Password Change Section -->
    <Label text="Change Password" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>

    <GridPane hgap="10" vgap="12">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        </rowConstraints>

        <Label text="Current Password:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <PasswordField fx:id="currentPasswordField" promptText="Enter your current password" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="New Password:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="newPasswordField" promptText="Enter a new password" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Confirm Password:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm the new password" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator/>

    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
<!--        <Button fx:id="logoutButton" text="Logout" onAction="#onLogoutClick"-->
<!--                style="-fx-background-color: #f87171; -fx-text-fill: white; -fx-padding: 8 16; -fx-font-weight: bold;"/>-->
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancelClick"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 8 16; -fx-font-weight: bold;"/>
        <Button fx:id="saveButton" text="Save Changes" onAction="#onSaveClick"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 8 16; -fx-font-weight: bold;"/>
    </HBox>

</VBox>
